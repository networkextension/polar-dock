// Multi-pane terminal workspace for the Polar host module.
//
// Each pane is a self-contained tile: pick a host → pick a skill →
// the pane opens a fresh skill.start via POST /shell/open and mounts
// an xterm bound to the byte-bridge WS that was already used by the
// single-modal shell flow (host_shell_handlers.go).
//
// Layouts are saved per-user-per-workspace and recallable from the
// "已保存" dropdown. Loading a saved layout auto-starts every pane's
// shell — the operator doesn't have to click "Start" N times.

import { Terminal } from "@xterm/xterm";
import { FitAddon } from "@xterm/addon-fit";
import { WebLinksAddon } from "@xterm/addon-web-links";
import "@xterm/xterm/css/xterm.css";

// noVNC is loaded lazily via dynamic import — its WebCodecs H264 probe
// uses top-level await, which esbuild 0.28 emits as `()=>{...await…}`
// in some bundle shapes and Safari rejects with "unexpected identifier".
// Dynamic import keeps the TLA inside an async context (the chunk is
// loaded async, our awaiter is `loadRFB` which is async).
type RFBClass = any;
let cachedRFB: RFBClass | undefined;
async function loadRFB(): Promise<RFBClass> {
  if (cachedRFB) return cachedRFB;
  const mod = await import("@novnc/novnc");
  cachedRFB = (mod as { default: RFBClass }).default;
  return cachedRFB;
}

import {
  fetchHosts,
  fetchHostSkillsForHost,
  kickHostShellSession,
  kickHostVNCSession,
  listHostShellSessions,
  listHostVNCSessions,
  openHostShell,
  openHostVNC,
} from "./api/hosts.js";
import { fetchCurrentUser, logout } from "./api/session.js";
import {
  createConsoleLayout,
  deleteConsoleLayout,
  fetchConsoleLayouts,
  updateConsoleLayout,
} from "./api/console-layouts.js";
import { hydrateSiteBrand, renderSidebarFoot } from "./lib/site.js";
import { bindThemeSync, initStoredTheme } from "./lib/theme.js";
import { byId } from "./lib/dom.js";
import type { Host, HostSkill } from "./types/hosts.js";
import type { ConsoleLayout, ConsolePaneConfig } from "./types/console.js";

initStoredTheme();
bindThemeSync();

const grid = byId<HTMLElement>("consoleGrid");
const layoutSelect = byId<HTMLSelectElement>("consoleLayoutSelect");
const savedSelect = byId<HTMLSelectElement>("consoleSavedSelect");
const saveBtn = byId<HTMLButtonElement>("consoleSaveBtn");
const deleteBtn = byId<HTMLButtonElement>("consoleDeleteBtn");
const closeAllBtn = byId<HTMLButtonElement>("consoleCloseAllBtn");
const logoutBtn = byId<HTMLButtonElement>("logoutBtn");

let hosts: Host[] = [];
const skillsByHost = new Map<string, HostSkill[]>();
const activePanes = new Map<string, ConsolePane>(); // pane_id → pane
const savedLayouts = new Map<number, ConsoleLayout>();

// Console pane: one tile of the grid. Owns its DOM node, xterm,
// WS, and the "empty picker" state. Supports two kinds today —
// "shell" (xterm + bidi byte WS to /ws/host/:id/shell/:run_id) and
// "vnc" (noVNC canvas + binary WS to /ws/host/:id/vnc/:run_id). The
// kind dispatches inside connect(); the picker stays the same.
class ConsolePane {
  readonly id: string;
  readonly root: HTMLElement;
  // Tracked so saveCurrentLayout() can serialize the grid.
  currentHostId?: string;
  currentSkillId?: number;
  currentKind?: string;
  // Run id of the live shell/vnc session — set on connect, cleared on
  // close. Used by the × button to kick the agent-side run (full
  // terminate) so refresh doesn't reattach to a zombie session that
  // bash still thinks is at the wrong rows/cols.
  currentRunId?: number;
  private titleEl: HTMLElement;
  private bodyEl: HTMLElement;
  private term?: Terminal;
  private fit?: FitAddon;
  private ws?: WebSocket;
  private rfb?: any;
  private resizeObs?: ResizeObserver;

  constructor(
    id: string,
    autofill?: { hostId: string; hostSkillId: number; kind?: string; runId?: number },
  ) {
    this.id = id;
    this.root = document.createElement("div");
    this.root.className = "console-pane";
    this.root.dataset.paneId = id;
    this.root.innerHTML = `
      <div class="console-pane-head">
        <span class="console-pane-title" data-pane-title>未选择</span>
        <button type="button" class="btn-inline" data-pane-close style="background:#dc2626;color:#fff;border-color:#dc2626;font-size:10px;padding:2px 8px;">×</button>
      </div>
      <div class="console-pane-body" data-pane-body></div>
    `;
    this.titleEl = this.root.querySelector("[data-pane-title]") as HTMLElement;
    this.bodyEl = this.root.querySelector("[data-pane-body]") as HTMLElement;

    this.root.querySelector<HTMLButtonElement>("[data-pane-close]")?.addEventListener("click", () => {
      void this.closeFully().then(() => ensurePaneCount());
    });

    if (autofill) {
      const hostLabel = hosts.find((h) => h.id === autofill.hostId)?.name || autofill.hostId;
      this.titleEl.textContent = `${hostLabel} · 启动中...`;
      this.bodyEl.innerHTML = `<div class="console-pane-empty"><div>启动中...</div></div>`;
      void this.connect(
        autofill.hostId,
        autofill.hostSkillId,
        undefined,
        autofill.kind,
        autofill.runId,
      ).catch((err) => {
        this.renderLoadError(autofill.hostId, autofill.hostSkillId, err);
      });
    } else {
      this.renderPicker();
    }
  }

  private renderPicker(): void {
    // The start button is styled inline (not via .btn-* classes) so it
    // pops on the dark pane background — the global secondary button
    // uses surface-light tones that vanish on #0f172a.
    this.bodyEl.innerHTML = `
      <div class="console-pane-empty">
        <div>选择主机 + skill 启动</div>
        <select data-pane-host class="input" style="max-width:240px;">
          <option value="">— host —</option>
          ${hosts.map((h) => `<option value="${h.id}">${escapeHTML(h.name)} (${escapeHTML(h.slug)})</option>`).join("")}
        </select>
        <select data-pane-skill class="input" disabled style="max-width:240px;">
          <option value="">— skill —</option>
        </select>
        <select data-pane-shell class="input" hidden style="max-width:240px;">
          <option value="">默认 shell (auto)</option>
          <option value="bash">bash</option>
          <option value="zsh">zsh</option>
          <option value="sh">sh</option>
        </select>
        <button type="button" data-pane-start disabled
          style="padding:8px 24px;border:none;border-radius:8px;background:#16a34a;color:#fff;font-weight:600;font-size:13px;cursor:pointer;opacity:.5;">
          启动
        </button>
      </div>
    `;

    const hostSel = this.bodyEl.querySelector<HTMLSelectElement>("[data-pane-host]")!;
    const skillSel = this.bodyEl.querySelector<HTMLSelectElement>("[data-pane-skill]")!;
    const shellSel = this.bodyEl.querySelector<HTMLSelectElement>("[data-pane-shell]")!;
    const startBtn = this.bodyEl.querySelector<HTMLButtonElement>("[data-pane-start]")!;

    const setStartEnabled = (enabled: boolean) => {
      startBtn.disabled = !enabled;
      startBtn.style.opacity = enabled ? "1" : ".5";
      startBtn.style.cursor = enabled ? "pointer" : "not-allowed";
    };

    hostSel.addEventListener("change", async () => {
      const hostId = hostSel.value;
      skillSel.innerHTML = `<option value="">加载中...</option>`;
      skillSel.disabled = true;
      shellSel.hidden = true;
      setStartEnabled(false);
      if (!hostId) {
        skillSel.innerHTML = `<option value="">— skill —</option>`;
        return;
      }
      let list = skillsByHost.get(hostId);
      if (!list) {
        const { response, data } = await fetchHostSkillsForHost(hostId);
        if (!response.ok) {
          skillSel.innerHTML = `<option value="">加载失败</option>`;
          return;
        }
        list = data.skills || [];
        skillsByHost.set(hostId, list);
      }
      // `shell` and `vnc` are the byte-streaming kinds the pane can
      // start directly. Nanokdp is also byte-streaming but needs
      // device_path + baud — operator must use the dedicated
      // host-detail flow for it. Including it here causes silent
      // skill-start failures (no device_path → agent refuses → WS
      // 404 / code=1006).
      const usable = list.filter((s) => s.kind === "shell" || s.kind === "vnc");
      skillSel.innerHTML =
        `<option value="">— skill —</option>` +
        usable
          .map((s) => `<option value="${s.id}" data-kind="${escapeHTML(s.kind)}">${escapeHTML(s.kind)} (id=${s.id})</option>`)
          .join("");
      skillSel.disabled = false;
    });

    skillSel.addEventListener("change", () => {
      const selected = skillSel.selectedOptions[0]?.dataset.kind || "";
      // Shell picker (bash/zsh/sh) only applies to shell skill. VNC
      // panes auth in-browser via noVNC and don't take shell choice.
      shellSel.hidden = selected !== "shell";
      setStartEnabled(!!skillSel.value);
    });

    startBtn.addEventListener("click", async () => {
      const hostId = hostSel.value;
      const skillId = Number(skillSel.value);
      const kind = skillSel.selectedOptions[0]?.dataset.kind || "shell";
      if (!hostId || !skillId) return;
      setStartEnabled(false);
      startBtn.textContent = "启动中...";
      try {
        const shellPref = shellSel.hidden ? undefined : shellSel.value || undefined;
        await this.connect(hostId, skillId, shellPref, kind);
      } catch (err) {
        setStartEnabled(true);
        startBtn.textContent = "启动";
        alert(`启动失败: ${err instanceof Error ? err.message : String(err)}`);
      }
    });
  }

  private renderLoadError(hostId: string, skillId: number, err: unknown): void {
    const msg = err instanceof Error ? err.message : String(err);
    this.titleEl.textContent = `${hostId} · 失败`;
    this.bodyEl.innerHTML = `
      <div class="console-pane-empty">
        <div style="color:#fca5a5;">无法启动 host=${escapeHTML(hostId)} skill=${skillId}</div>
        <div style="font-size:11px; color:#94a3b8;">${escapeHTML(msg)}</div>
        <button type="button" class="btn-inline btn-secondary" data-pane-repick>重新选择</button>
      </div>
    `;
    this.bodyEl.querySelector<HTMLButtonElement>("[data-pane-repick]")?.addEventListener("click", () => {
      this.currentHostId = undefined;
      this.currentSkillId = undefined;
      this.renderPicker();
    });
  }

  private async connect(
    hostId: string,
    skillId: number,
    shell?: string,
    kind?: string,
    existingRunId?: number,
  ): Promise<void> {
    // kind comes from either the picker's data-kind attr or the
    // restore path; default to "shell" for layouts saved before VNC
    // support landed (the field is optional in ConsolePaneConfig).
    const resolvedKind = kind || "shell";
    if (resolvedKind === "vnc") {
      return this.connectVnc(hostId, skillId, existingRunId);
    }
    return this.connectShell(hostId, skillId, shell, existingRunId);
  }

  // buildWSURL constructs the ws[s] URL for an existing run on this
  // host. Used by the reattach path where we already know the run_id
  // (from listHostShellSessions / listHostVNCSessions) and don't need
  // to call /open at all. Browser-side construction is correct because
  // location.host already includes the port the operator's tab sees.
  private buildWSURL(hostId: string, kind: string, runId: number): string {
    const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
    return `${proto}//${window.location.host}/ws/host/${hostId}/${kind}/${runId}`;
  }

  private async connectShell(
    hostId: string,
    skillId: number,
    shell?: string,
    existingRunId?: number,
  ): Promise<void> {
    const host = hosts.find((h) => h.id === hostId);

    // Mount the terminal + fit it BEFORE calling /shell/open, so the
    // agent's PTY starts the right size for this pane. Otherwise the
    // initial 24×80 default fills with bash startup output, fit later
    // grows the viewport, and the cursor lands at the bottom of an
    // oversized terminal — top half ends up blank.
    this.bodyEl.innerHTML = `<div class="console-pane-term" data-pane-term></div>`;
    const termEl = this.bodyEl.querySelector<HTMLElement>("[data-pane-term]")!;
    const term = new Terminal({
      fontFamily: "ui-monospace, 'JetBrains Mono', monospace",
      fontSize: 12,
      cursorBlink: true,
      convertEol: false,
      scrollback: 5000,
      theme: { background: "#0f172a", foreground: "#e2e8f0" },
    });
    const linksAddon = new WebLinksAddon();
    const fit = new FitAddon();
    term.loadAddon(fit);
    term.loadAddon(linksAddon);
    term.open(termEl);

    // Wait for the browser to lay out the newly-mounted <div> before
    // measuring it. Without this rAF, fit() runs in the same task that
    // injected the HTML — the container's clientHeight is often 0 or
    // stale, fit defaults to a tiny grid, and the agent's PTY opens at
    // 30×100. The resize observer then grows xterm to ~60 rows after
    // the layout settles, but bash has already printed into a small
    // buffer and the leftover content + cursor end up clumped at the
    // bottom of the now-tall viewport. Two rAFs is belt-and-suspenders:
    // first to flush layout, second to ensure measurements are stable.
    // (Brought over from commit b2d7b3c on feat/host-macmon-grafana-embed.)
    await new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));
    try {
      fit.fit();
    } catch {
      /* container still not laid out — sendResize on WS open will recover */
    }

    // Two paths:
    //   A) reattach (existingRunId given): build ws_url client-side,
    //      skip /shell/open entirely. Operator refresh / layout restore
    //      lands here.
    //   B) fresh start: POST /shell/open with measured rows/cols, get
    //      run_id + ws_url back, agent dispatches skill.start.
    let runId: number;
    let wsURL: string;
    if (typeof existingRunId === "number" && existingRunId > 0) {
      runId = existingRunId;
      wsURL = this.buildWSURL(hostId, "shell", runId);
    } else {
      const proposed: { rows: number; cols: number; shell?: string } = {
        rows: term.rows || 30,
        cols: term.cols || 100,
      };
      if (shell) proposed.shell = shell;
      const { response, data } = await openHostShell(hostId, skillId, proposed);
      if (!response.ok || !data.ws_url || !data.run_id) {
        term.dispose();
        throw new Error(data.error || `HTTP ${response.status}`);
      }
      runId = data.run_id;
      wsURL = data.ws_url;
    }
    this.currentHostId = hostId;
    this.currentSkillId = skillId;
    this.currentKind = "shell";
    this.currentRunId = runId;
    term.focus();

    this.term = term;
    this.fit = fit;
    this.titleEl.textContent = `${host?.name || hostId} · run=${runId}`;

    const ws = new WebSocket(wsURL);
    ws.binaryType = "arraybuffer";
    this.ws = ws;

    const sendResize = () => {
      try {
        fit.fit();
      } catch {
        return;
      }
      if (ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ kind: "resize", rows: term.rows, cols: term.cols }));
      }
    };
    ws.addEventListener("open", () => {
      term.writeln(`\x1b[2m[console] connected · run=${runId}\x1b[0m`);
      sendResize();
    });
    ws.addEventListener("message", (ev) => {
      if (typeof ev.data === "string") return;
      // Don't force scrollToBottom on each write — let xterm's natural
      // tail-f behavior keep the cursor visible. (See commits 57af57f
      // + 877ebf3 for the "blank top + cursor below" postmortem.)
      // Defensive try/catch: xterm's parser can throw on malformed
      // escape sequences from glitchy output (broken dmesg, corrupted
      // streams); without this, one bad chunk kills the message
      // handler and the bridge effectively stops processing output.
      // (Brought over from commit ca6eb5e.)
      try {
        term.write(new Uint8Array(ev.data));
      } catch (err) {
        // eslint-disable-next-line no-console
        console.warn("[console] term.write threw, dropping chunk:", err);
      }
    });
    ws.addEventListener("close", (ev) => {
      term.writeln(`\r\n\x1b[2m[console] closed (code=${ev.code})\x1b[0m`);
      term.options.disableStdin = true;
    });
    ws.addEventListener("error", () => {
      term.writeln(`\r\n\x1b[31m[console] WS error\x1b[0m`);
    });
    term.onData((s) => {
      if (ws.readyState === WebSocket.OPEN) {
        ws.send(new TextEncoder().encode(s));
      }
    });
    term.onResize(() => sendResize());

    // React to grid layout changes so the xterm cell occupies its
    // tile fully. ResizeObserver on the pane root catches both the
    // user changing layout count and browser window resize.
    this.resizeObs = new ResizeObserver(() => {
      if (this.fit) {
        try {
          this.fit.fit();
        } catch {
          /* term may be disposed */
        }
      }
    });
    this.resizeObs.observe(this.root);
  }

  // connectVnc opens a VNC relay via /vnc/open and mounts a noVNC RFB
  // canvas bound to the returned ws_url. The RFB constructor handles
  // the entire RFB handshake including auth — noVNC 1.7+ supports both
  // standard VNC auth (security type 2) and Apple Auth (security type
  // 30 / ARD with DH + AES) natively. macOS Screen Sharing speaks RFB
  // 003.889 + type 30 by default; the operator enters their macOS
  // username + password in the noVNC credentials modal and the rest
  // is handled in-browser.
  private async connectVnc(
    hostId: string,
    skillId: number,
    existingRunId?: number,
  ): Promise<void> {
    const host = hosts.find((h) => h.id === hostId);

    // Same two-path split as shell: reattach if existingRunId given,
    // else POST /vnc/open to mint a fresh run.
    let runId: number;
    let wsURL: string;
    if (typeof existingRunId === "number" && existingRunId > 0) {
      runId = existingRunId;
      wsURL = this.buildWSURL(hostId, "vnc", runId);
    } else {
      const { response, data } = await openHostVNC(hostId, skillId, {});
      if (!response.ok || !data.ws_url || !data.run_id) {
        throw new Error(data.error || `HTTP ${response.status}`);
      }
      runId = data.run_id;
      wsURL = data.ws_url;
    }
    this.currentHostId = hostId;
    this.currentSkillId = skillId;
    this.currentKind = "vnc";
    this.currentRunId = runId;
    this.titleEl.textContent = `${host?.name || hostId} · vnc · run=${runId}`;

    // Mount the noVNC canvas inside the pane body. RFB will inject
    // its own <canvas> into the provided element and stretch to fit.
    this.bodyEl.innerHTML = `<div class="console-pane-vnc" data-pane-vnc style="width:100%;height:100%;background:#000;"></div>`;
    const vncEl = this.bodyEl.querySelector<HTMLElement>("[data-pane-vnc]")!;

    // noVNC's RFB takes a target element + WS URL + options. shared=true
    // matches macOS Screen Sharing default (don't kick existing viewers).
    const RFBCtor = await loadRFB();
    const rfb = new RFBCtor(vncEl, wsURL, {
      shared: true,
    });
    rfb.scaleViewport = true;
    rfb.resizeSession = false; // RFB protocol handles size; don't ask
                               // the server to resize its framebuffer
                               // — macOS Screen Sharing rejects that
                               // and the connection silently degrades.
    rfb.background = "#000";
    this.rfb = rfb;

    // Status badge — overlaid on the black canvas so the operator
    // sees what state RFB is in instead of staring at a dead screen.
    const statusEl = document.createElement("div");
    statusEl.style.cssText = "position:absolute;top:8px;left:8px;background:#0008;color:#fff;padding:4px 8px;font-size:11px;border-radius:4px;font-family:monospace;z-index:10;pointer-events:none;";
    statusEl.textContent = "VNC 连接中...";
    vncEl.style.position = "relative";
    vncEl.appendChild(statusEl);
    const setStatus = (text: string) => {
      statusEl.textContent = text;
    };

    rfb.addEventListener("connect", () => {
      setStatus("VNC 已连接");
      // Fade the badge away after a beat so it doesn't cover the
      // desktop forever.
      setTimeout(() => {
        statusEl.style.transition = "opacity .8s";
        statusEl.style.opacity = "0";
      }, 1500);
    });
    rfb.addEventListener("disconnect", (ev: { detail?: { clean?: boolean } }) => {
      const clean = ev.detail?.clean !== false;
      this.bodyEl.innerHTML = `
        <div class="console-pane-empty">
          <div>VNC 连接已断开${clean ? "" : "（异常）"}</div>
          <button type="button" class="btn-inline btn-secondary" data-pane-repick>重新选择</button>
        </div>
      `;
      this.bodyEl.querySelector<HTMLButtonElement>("[data-pane-repick]")?.addEventListener("click", () => {
        this.currentHostId = undefined;
        this.currentSkillId = undefined;
        this.currentKind = undefined;
        this.renderPicker();
      });
    });
    rfb.addEventListener("securityfailure", (ev: { detail?: { reason?: string; status?: number } }) => {
      const reason = ev.detail?.reason || "unknown";
      const status = ev.detail?.status;
      setStatus(`VNC 认证失败: ${reason}${status !== undefined ? ` (status=${status})` : ""}`);
      alert(`VNC 认证失败: ${reason}\n密码错？账号错？再试用 macOS 登录用户名 + 密码。`);
    });
    // RFB fires this when the server demands credentials (after
    // security-type negotiation). noVNC does NOT show a modal of its
    // own — the embedder has to call sendCredentials. For Apple Auth
    // type 30 the server wants {username, password} (macOS login).
    // For standard VNC Auth (security type 2) only {password}.
    rfb.addEventListener("credentialsrequired", () => {
      setStatus("等待凭据输入");
      // Use window.prompt — minimal but works without bringing in a
      // modal library. Refresh / typing wrong password triggers
      // securityfailure → operator gets the repick path. Username can
      // be blank for standard VNC Auth servers (they ignore it).
      const username = window.prompt("VNC 用户名（标准 VNC 留空，Apple Auth 用 macOS 登录用户）", "") ?? "";
      const password = window.prompt("VNC 密码", "") ?? "";
      try {
        rfb.sendCredentials({ username, password, target: "" });
      } catch (err) {
        setStatus(`sendCredentials 失败: ${err instanceof Error ? err.message : String(err)}`);
      }
    });
  }

  dispose(): void {
    this.resizeObs?.disconnect();
    if (this.rfb) {
      try {
        this.rfb.disconnect();
      } catch {
        /* ignore */
      }
      this.rfb = undefined;
    }
    if (this.ws && this.ws.readyState <= WebSocket.OPEN) {
      try {
        this.ws.close(1000, "pane_closed");
      } catch {
        /* ignore */
      }
    }
    this.term?.dispose();
  }

  // closeFully terminates the agent-side session (DELETE /sessions/:run_id
  // → dock dispatches skill.stop to agent) BEFORE tearing down the local
  // UI. Without this, × just detaches the bridge — the PTY / VNC relay
  // stays alive until idle_timeout, and refresh / re-open auto-reattaches
  // (replays backscroll, bash still at old rows/cols, "blank top + cursor
  // below" symptom comes back). Best-effort: if the kick 404s or errors,
  // we still dispose locally. (Brought over from commit 72e4c82.)
  async closeFully(): Promise<void> {
    const hostId = this.currentHostId;
    const runId = this.currentRunId;
    const kind = this.currentKind;
    this.dispose();
    activePanes.delete(this.id);
    this.root.remove();
    if (hostId && typeof runId === "number" && runId > 0) {
      try {
        if (kind === "vnc") {
          await kickHostVNCSession(hostId, runId);
        } else {
          await kickHostShellSession(hostId, runId);
        }
      } catch {
        /* network blip during teardown — agent's idle_timeout reaps */
      }
    }
  }
}

function gridColsFor(paneCount: number): number {
  if (paneCount <= 1) return 1;
  if (paneCount <= 4) return 2;
  return 3;
}

function ensurePaneCount(): void {
  const target = Number(layoutSelect.value || 4);
  grid.dataset.cols = String(gridColsFor(target));

  while (activePanes.size < target) {
    const id = "p" + Math.random().toString(36).slice(2, 8);
    const pane = new ConsolePane(id);
    activePanes.set(id, pane);
    grid.appendChild(pane.root);
  }
  // Shrink if user picked fewer panes. Prefer to drop empty (un-started)
  // panes first so we don't terminate live shells unexpectedly.
  while (activePanes.size > target) {
    const candidates = Array.from(activePanes.values());
    const pickle =
      candidates.find((p) => !p.root.querySelector("[data-pane-term]")) ||
      candidates[candidates.length - 1];
    pickle.dispose();
    activePanes.delete(pickle.id);
    pickle.root.remove();
  }
}

// Pick a layout-count select value matching this pane count, so the
// existing `data-cols` mapping stays the single source of truth.
function nearestLayoutCount(n: number): number {
  const known = [1, 2, 3, 4, 6, 9];
  for (const v of known) {
    if (v >= n) return v;
  }
  return known[known.length - 1];
}

function disposeAllPanes(): void {
  activePanes.forEach((p) => {
    p.dispose();
    p.root.remove();
  });
  activePanes.clear();
}

function loadLayout(layout: ConsoleLayout): void {
  const panes = layout.panes_config || [];
  if (panes.length === 0) {
    alert("空布局，未生效");
    return;
  }
  disposeAllPanes();
  const target = nearestLayoutCount(panes.length);
  layoutSelect.value = String(target);
  grid.dataset.cols = String(gridColsFor(target));

  for (const cfg of panes) {
    const id = "p" + Math.random().toString(36).slice(2, 8);
    const pane = new ConsolePane(id, {
      hostId: cfg.host_id,
      hostSkillId: cfg.host_skill_id,
      kind: cfg.kind,
    });
    activePanes.set(id, pane);
    grid.appendChild(pane.root);
  }
  // Fill remaining slots (e.g. layout has 3 panes but layoutSelect maps to 4)
  // with empty pickers so the grid looks consistent.
  while (activePanes.size < target) {
    const id = "p" + Math.random().toString(36).slice(2, 8);
    const pane = new ConsolePane(id);
    activePanes.set(id, pane);
    grid.appendChild(pane.root);
  }
}

function refreshSavedSelect(selectedId?: number): void {
  const opts: string[] = [`<option value="">— 选择已保存的布局 —</option>`];
  const items = Array.from(savedLayouts.values()).sort((a, b) =>
    a.updated_at < b.updated_at ? 1 : -1,
  );
  for (const l of items) {
    const sel = selectedId && l.id === selectedId ? " selected" : "";
    opts.push(`<option value="${l.id}"${sel}>${escapeHTML(l.name)}</option>`);
  }
  savedSelect.innerHTML = opts.join("");
  deleteBtn.disabled = !savedSelect.value;
}

async function refreshSavedLayouts(selectedId?: number): Promise<void> {
  const { response, data } = await fetchConsoleLayouts();
  savedLayouts.clear();
  if (response.ok && data.layouts) {
    for (const l of data.layouts) {
      savedLayouts.set(l.id, l);
    }
  }
  refreshSavedSelect(selectedId);
}

function currentPanesConfig(): ConsolePaneConfig[] {
  const panes: ConsolePaneConfig[] = [];
  // Iterate in DOM order so the saved layout matches what the
  // operator sees on screen.
  for (const child of Array.from(grid.children) as HTMLElement[]) {
    const paneId = child.dataset.paneId;
    if (!paneId) continue;
    const pane = activePanes.get(paneId);
    if (!pane || !pane.currentHostId || !pane.currentSkillId) continue;
    const cfg: ConsolePaneConfig = {
      host_id: pane.currentHostId,
      host_skill_id: pane.currentSkillId,
    };
    // Only persist kind when it's non-shell — keeps the saved JSON
    // backward-compatible with older layouts (no `kind` field = shell
    // by default in the restore path).
    if (pane.currentKind && pane.currentKind !== "shell") {
      cfg.kind = pane.currentKind;
    }
    panes.push(cfg);
  }
  return panes;
}

async function saveCurrentLayout(): Promise<void> {
  const panes = currentPanesConfig();
  if (panes.length === 0) {
    alert("没有可保存的活动 pane（请先启动至少一个 shell/nanokdp）");
    return;
  }
  // If a layout is currently selected, default to updating it; allow
  // rename. Otherwise prompt for a new name.
  const selectedId = Number(savedSelect.value || 0);
  const existing = selectedId ? savedLayouts.get(selectedId) : undefined;
  const defaultName = existing?.name || `布局 ${new Date().toLocaleString()}`;
  const name = window.prompt("布局名称", defaultName);
  if (!name) return;
  const trimmed = name.trim();
  if (!trimmed) return;

  if (existing && trimmed === existing.name) {
    const { response, data } = await updateConsoleLayout(existing.id, { panes_config: panes });
    if (!response.ok) {
      alert(`保存失败: ${data.error || response.status}`);
      return;
    }
    await refreshSavedLayouts(existing.id);
  } else {
    const { response, data } = await createConsoleLayout({ name: trimmed, panes_config: panes });
    if (!response.ok) {
      const hint = response.status === 409 ? "已存在同名布局，请换一个名字" : data.error;
      alert(`保存失败: ${hint || response.status}`);
      return;
    }
    await refreshSavedLayouts(data.layout?.id);
  }
}

async function deleteSelectedLayout(): Promise<void> {
  const id = Number(savedSelect.value || 0);
  if (!id) return;
  const layout = savedLayouts.get(id);
  if (!layout) return;
  if (!window.confirm(`确定删除布局 "${layout.name}"？`)) return;
  const { response, data } = await deleteConsoleLayout(id);
  if (!response.ok) {
    alert(`删除失败: ${data.error || response.status}`);
    return;
  }
  await refreshSavedLayouts();
}

async function bootstrap(): Promise<void> {
  await hydrateSiteBrand();
  const { response: meRes, data: me } = await fetchCurrentUser();
  if (!meRes.ok) {
    window.location.href = "/login.html?next=/console.html";
    return;
  }
  renderSidebarFoot(me);

  const { response: hostsRes, data: hostsData } = await fetchHosts();
  if (hostsRes.ok) {
    hosts = hostsData.hosts || [];
  }

  layoutSelect.addEventListener("change", () => ensurePaneCount());
  closeAllBtn.addEventListener("click", async () => {
    // Confirm once, then fan out closeFully across every live pane so
    // each agent-side run gets explicitly killed (not just bridge
    // detached). Picker-only / un-started panes have no run id and
    // closeFully no-ops the kick step.
    if (activePanes.size > 0 && !window.confirm("关闭所有 pane（包括 agent 端的 PTY / VNC）？")) {
      return;
    }
    await Promise.all(
      Array.from(activePanes.values()).map((p) => p.closeFully().catch(() => undefined)),
    );
    disposeAllPanes();
    ensurePaneCount();
  });
  savedSelect.addEventListener("change", () => {
    deleteBtn.disabled = !savedSelect.value;
    const id = Number(savedSelect.value || 0);
    if (!id) return;
    const layout = savedLayouts.get(id);
    if (layout) loadLayout(layout);
  });
  saveBtn.addEventListener("click", () => {
    void saveCurrentLayout();
  });
  deleteBtn.addEventListener("click", () => {
    void deleteSelectedLayout();
  });
  logoutBtn.addEventListener("click", async () => {
    await logout();
    window.location.href = "/login.html";
  });

  await refreshSavedLayouts();

  // Reattach: if the operator has live shell sessions across hosts
  // (e.g. they refreshed the page), spawn panes pre-bound to those
  // (host, host_skill) tuples — openHostShell on the dock side will
  // dedupe and return the existing run_id, so the panes land back on
  // the live PTYs without the operator having to re-pick anything.
  const restored = await restoreActiveSessions();
  if (restored === 0) {
    ensurePaneCount();
  }
}

async function restoreActiveSessions(): Promise<number> {
  if (hosts.length === 0) return 0;
  // Each restored session keeps its run_id so the pane connects WS
  // directly without re-running /open (which now always mints fresh
  // runs — no more implicit (host, skill, operator) dedup).
  const sessions: { hostId: string; hostSkillId: number; kind: string; runId: number }[] = [];
  await Promise.all(
    hosts.map(async (h) => {
      const [shellRes, vncRes] = await Promise.all([
        listHostShellSessions(h.id),
        listHostVNCSessions(h.id),
      ]);
      if (shellRes.response.ok && shellRes.data.sessions) {
        for (const s of shellRes.data.sessions) {
          sessions.push({
            hostId: s.host_id,
            hostSkillId: s.host_skill_id,
            kind: "shell",
            runId: s.run_id,
          });
        }
      }
      if (vncRes.response.ok && vncRes.data.sessions) {
        for (const s of vncRes.data.sessions) {
          sessions.push({
            hostId: s.host_id,
            hostSkillId: s.host_skill_id,
            kind: "vnc",
            runId: s.run_id,
          });
        }
      }
    }),
  );
  if (sessions.length === 0) return 0;
  const target = nearestLayoutCount(sessions.length);
  layoutSelect.value = String(target);
  grid.dataset.cols = String(gridColsFor(target));
  for (const cfg of sessions) {
    const id = "p" + Math.random().toString(36).slice(2, 8);
    const pane = new ConsolePane(id, {
      hostId: cfg.hostId,
      hostSkillId: cfg.hostSkillId,
      kind: cfg.kind,
      runId: cfg.runId,
    });
    activePanes.set(id, pane);
    grid.appendChild(pane.root);
  }
  while (activePanes.size < target) {
    const id = "p" + Math.random().toString(36).slice(2, 8);
    const pane = new ConsolePane(id);
    activePanes.set(id, pane);
    grid.appendChild(pane.root);
  }
  return sessions.length;
}

function escapeHTML(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

void bootstrap();
