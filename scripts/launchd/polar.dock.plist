<?xml version="1.0" encoding="UTF-8"?>
<!--
  polar-dock launchd plist for macOS user-mode auto-start.

  Drop at ~/Library/LaunchAgents/polar.dock.plist, then:
    launchctl load -w ~/Library/LaunchAgents/polar.dock.plist

  The plist invokes the wrapper at ~/.local/bin/polar-dock-launch.sh
  which sources per-box secrets from ~/polar-dock.env. Secrets stay
  out of the committed file — see scripts/launchd/polar-dock.env.sample
  for the env file shape.

  See scripts/launchd/setup.sh for a one-shot installer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>polar.dock</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/local/.local/bin/polar-dock-launch.sh</string>
  </array>

  <!-- Auto-start at user login + auto-restart only on non-zero exit
       (so `launchctl unload` actually stops the dock when an admin
       wants to take it down for maintenance). ThrottleInterval gives
       Postgres + Redis time to come up before dock loops on DB pool
       errors after a fresh boot. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/polar.dock.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/polar.dock.log</string>
</dict>
</plist>
