# Per-box secrets for polar-dock. Copy to ~/polar-dock.env and
# chmod 600 — the launchd plist's wrapper sources from there.
# Generate fresh values with `openssl rand -hex 32` per box.

# Bearer required on GET /metrics (must match Prometheus's scrape
# config bearer_token). Empty = endpoint disabled (404).
export METRICS_TOKEN=""

# 32-byte hex AES-GCM key for the host_skill_credentials vault
# (P1c.4). Unset = credentials stored in plaintext + UI badges them
# "unencrypted". Set this before any real API key gets PUT.
export POLAR_CREDENTIAL_KEY=""

# 32-byte hex AES-GCM key for iOS distribution secrets (.p12
# passwords). Same shape as POLAR_CREDENTIAL_KEY but separate
# domain so the keys can be rotated independently.
export IOSDIST_RESOURCE_KEY=""

# Absolute paths the dock binds at startup. Defaults derived from
# CWD; setting these prevents a launchd cwd flip (default /) from
# forking the data tree.
export UPLOAD_DIR="$HOME/github/Polar-/data/uploads"
export MARKDOWN_DIR="$HOME/github/Polar-/data/markdown"
export GEOLITE_DB_PATH="$HOME/github/Polar-/data/GeoLite2-City.mmdb"

# Needed so polar-dock can find brew-installed tools (git, etc.)
# when shelling out from a launchd context that doesn't inherit
# the operator's interactive shell PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
