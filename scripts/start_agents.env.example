# start_agents.env — copy to ~/.polar/start_agents.env and edit.
# scripts/start_agents.sh sources this on each run, so values
# persist across logins without polluting your shell rc.
#
# Each tool is optional; leave its line blank or commented out
# to skip starting that polar-agent.

# Bot user IDs (form bot_xxxxxxxxxxxxxxxx, copy from bots.html)
export POLAR_BOT_KIMI="bot_xxxxxxxxxxxxxxxx"
export POLAR_BOT_CLAUDE="bot_xxxxxxxxxxxxxxxx"
export POLAR_BOT_CODEX="bot_xxxxxxxxxxxxxxxx"

# Per-tool workdirs. Default is $POLAR_WORK_ROOT/work_<tool>.
# Override individually if you want different layout (e.g. each
# tool in its own git repo).
# export POLAR_WORK_ROOT="$HOME/github"
# export POLAR_WORKDIR_KIMI="$HOME/github/myproj-kimi"
# export POLAR_WORKDIR_CLAUDE="$HOME/github/myproj-claude"
# export POLAR_WORKDIR_CODEX="$HOME/github/myproj-codex"

# Wall-clock cap per spawn. Applied to all tools (env name kept
# from v1 polar-agent for compat).
export POLAR_KIMI_TIMEOUT="1h"

# Override polar-agent binary location if not on PATH.
# export POLAR_AGENT_BIN="$HOME/.local/bin/polar-agent"

# Optional: per-tool proxy via tools.json env field (see
# cmd/polar-agent/tools.example.json). HTTP_PROXY / HTTPS_PROXY
# exported here are inherited by all child polar-agents AND their
# subprocesses (kimi-cli / claude / codex).
# export https_proxy="http://127.0.0.1:10082"
# export http_proxy="http://127.0.0.1:10082"
