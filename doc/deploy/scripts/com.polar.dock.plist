<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polar.dock</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source "$HOME/.config/polar/dock.env"; exec "$HOME/.local/bin/polar-dock"</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/local/polar</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/local/polar/dock.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/local/polar/dock.log</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
