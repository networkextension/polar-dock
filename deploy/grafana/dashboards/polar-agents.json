{
  "title": "Polar — Agents & Business",
  "uid": "polar-agents",
  "tags": ["polar", "phase3", "agents", "business"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Agents attached now",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum by (tool) (polar_agent_attached)", "legendFormat": "{{tool}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Agents attached over time",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 0, "w": 16, "h": 6},
      "targets": [
        {"expr": "polar_agent_attached", "legendFormat": "{{tool}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Research dispatches per minute (by status)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status) (rate(polar_research_dispatch_total[1m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "stat",
      "title": "Research success rate (24h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(increase(polar_research_dispatch_total{status=\"succeeded\"}[24h])) / clamp_min(sum(increase(polar_research_dispatch_total{status=~\"succeeded|failed\"}[24h])), 1)",
          "legendFormat": "success rate",
          "refId": "A"
        },
        {
          "expr": "sum(increase(polar_research_dispatch_total{status=\"succeeded\"}[24h]))",
          "legendFormat": "succeeded",
          "refId": "B"
        },
        {
          "expr": "sum(increase(polar_research_dispatch_total{status=\"failed\"}[24h]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "iOS sign-task throughput",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status) (rate(polar_iosdist_build_total[5m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "stat",
      "title": "iOS build outcomes (24h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status) (increase(polar_iosdist_build_total[24h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    }
  ]
}
